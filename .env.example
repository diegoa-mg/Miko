# Base de datos
DB_NAME=pos_multisede
DB_USER=admin
DB_PASSWORD=changeme

# Supabase Storage (fotos de perfil)
# URL: Supabase > Project Overview (debajo del nombre del proyecto)
# Clave: Supabase > Project Settings > API Keys > Publishable and secret API keys > Secret keys
# La clave es la "Secret keys", nunca la "Publishable key"
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=cambia-esto-por-la-clave-secreta-de-supabase
SUPABASE_BUCKET=fotos-perfil-dev

# JWT Autenticacion
JWT_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=http://localhost:5173

# Time Zone
BUSINESS_TIMEZONE=America/Mexico_City